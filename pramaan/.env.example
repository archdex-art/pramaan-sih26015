# Host port mappings for `docker compose`.
#
# Defaults are deliberately in the 5xxxx range rather than the services'
# canonical ports. Postgres 5432, Redis 6379 and MinIO 9000/9001 collide with
# almost every other Docker project a developer has running — verified on a
# clean dev machine during Stage 0, where 5432, 6379, 9000 and 9001 were all
# already bound. A compose file that only works when nothing else is running is
# not a one-command demo.
#
# Copy to `.env` and override as needed. Container-to-container traffic uses
# service names and internal ports, so changing these affects only host access.

PRAMAAN_API_PORT=8000
PRAMAAN_PG_PORT=55432
PRAMAAN_REDIS_PORT=56379
PRAMAAN_MINIO_PORT=59000
PRAMAAN_MINIO_CONSOLE_PORT=59001
PRAMAAN_TITILER_PORT=58001
