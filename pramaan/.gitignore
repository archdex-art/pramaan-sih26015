__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.log

# data caches — never commit rasters/photos
data/cache/**
!data/cache/.gitkeep
*.tif
*.tiff
*.jp2
# DEM tiles and their derivatives: 223 MB, and re-downloadable in ~30 s from
# NASADEM via `scripts/build_terrain.py`. The *measured outputs* of that script
# (data/demo/terrain.json) ARE committed - they are the evidence.
*.hgt
*.num
*.swb
data/demo/dem/**

# generated
docs/api/openapi.json
docs/diagrams/*.svg

# secrets
deploy/env/*.env
.DS_Store

# The film is a build artifact but the two cuts ARE deliverables — they go in a
# submission portal. Committed on purpose; the working directory is not.
build/video/clips/
build/video/seg/
build/video/cards/
